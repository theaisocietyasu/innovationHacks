# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# Site origin — used for CORS on API routes. No trailing slash.
SITE_URL=https://yourdomain.com

# Shared secret for accessing resume files via /api/resume/[id]
RESUME_ACCESS_TOKEN=replace-with-a-long-random-secret
